<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.isetr.tp5app.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_liste"
        android:name="com.isetr.tp5app.ui.liste.ListeEtudiantsFragment"
        android:label="@string/menu_liste"
        tools:layout="@layout/fragment_liste_etudiants">
        <action
            android:id="@+id/action_nav_liste_to_nav_detail"
            app:destination="@id/nav_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_ajout"
        android:name="com.isetr.tp5app.ui.ajout.AjoutEtudiantFragment"
        android:label="@string/menu_ajout"
        tools:layout="@layout/fragment_ajout">
        <action
            android:id="@+id/action_nav_ajout_to_nav_liste"
            app:destination="@id/nav_liste"
            app:popUpTo="@id/nav_ajout"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_detail"
        android:name="com.isetr.tp5app.ui.detail.DetailFragment"
        android:label="@string/menu_detail"
        tools:layout="@layout/fragment_detail">
        <!-- Après suppression : retour à la liste (on dépile Détails et l'ancienne Liste) -->
        <action
            android:id="@+id/action_nav_detail_to_nav_liste"
            app:destination="@id/nav_liste"
            app:popUpTo="@id/nav_liste"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
